class Solution(object):
    def isValid(self, s):
        """
        :type s: str
        :rtype: bool
        """
        # more time complexity
        # stack = []
        # for ch in s:
        #     if stack:
        #         if (ch == '}' and stack[-1] == '{') or (ch == ')' and stack[-1] == '(') or (ch == ']' and stack[-1] == '['):
        #             stack.pop()
        #             continue
        #     stack.append(ch)
        # return len(stack)==0

        # It will not store closing brackets. If not matching it will return False right away
        stack = []
        seen = {')':'(','}':'{',']':'['}
        for ch in s:
            if ch in seen:
                if stack and stack[-1] == seen[ch]:
                    stack.pop()
                else:
                    return False
            else:
                stack.append(ch)
        return not stack
