class Solution(object):
    def nextGreaterElement(self, nums1, nums2):
        stack = []
        res = [-1]*len(nums1)
        for i in range(0, len(nums2)):
            # nums1 = [1,3,5,2,4]
            # nums2 = [6,5,4,3,2,1,7]
            # output = [7,7,7,7,7]
            while stack and nums2[i] > stack[-1]:
                val = stack.pop()
                if val in nums1:
                    res[nums1.index(val)] = nums2[i]
            stack.append(nums2[i])
        return res
