class Solution(object):

    def process(self, s):
        stack = []
        for c in s:
            if stack and c == '#':
                stack.pop(-1)
            elif c != '#':
                stack.append(c)

        return ''.join(stack)

    def backspaceCompare(self, s, t):
        """
        :type s: str
        :type t: str
        :rtype: bool
        """

        return self.process(s) == self.process(t)
